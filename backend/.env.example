# Backend Environment Configuration Example
PORT=8080

# PostgreSQL Configuration (Render / AWS / Self-Hosted)
# Defaults to in-memory H2 if omitted
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wildfire_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Security & CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://wildfire.vercel.app

# OpenAI API Key (Never commit real secrets)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
